generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =========================================================
// Identity & subscriptions
// =========================================================

enum Tier {
  FREE
  PRO
  ELITE
}

enum SubStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model User {
  id                 String         @id @default(cuid())
  clerkId            String         @unique
  email              String         @unique
  name               String?
  tier               Tier           @default(FREE)
  locale             String         @default("ko") // "ko" | "en"
  referralCode       String         @unique @default(cuid())
  referredBy         String? // clerkId of referrer
  referralBonusUntil DateTime? // free month bonus expiry
  watchlist          Json? // { items: [{ keyword, createdAt }] }
  portfolio          Json? // { assets: [{ symbol, name, qty? }] }
  digestEmail        Boolean        @default(true)
  digestHour         Int            @default(8)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  subscription       Subscription?
  insightUsage       InsightUsage[]
  readStates         ReadState[]
  savedArticles      SavedArticle[]
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  stripeCustomerId     String    @unique
  stripeSubscriptionId String    @unique
  stripePriceId        String
  status               SubStatus
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =========================================================
// AI insights
// =========================================================

enum InsightKind {
  ARTICLE
  CLUSTER
  CONNECTIONS
  DAILY_RECAP
  PERSONAL_BRIEFING
}

model Insight {
  id        String      @id @default(cuid())
  kind      InsightKind
  cacheKey  String      @unique
  locale    String      @default("ko")
  payload   Json
  expiresAt DateTime
  createdAt DateTime    @default(now())

  @@index([cacheKey])
  @@index([expiresAt])
  @@index([kind])
}

model InsightUsage {
  id        String      @id @default(cuid())
  userId    String
  kind      InsightKind
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, kind, createdAt])
}

// =========================================================
// Per-user article state
// =========================================================

model ReadState {
  userId    String
  articleId String
  readAt    DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([userId, readAt])
  @@index([articleId])
}

model SavedArticle {
  userId    String
  articleId String
  savedAt   DateTime @default(now())
  note      String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([userId, savedAt])
  @@index([articleId])
}

// =========================================================
// Daily recap / SEO landing content
// =========================================================

model DailyRecap {
  id         String   @id @default(cuid())
  date       String // "YYYY-MM-DD" KST
  locale     String
  headline   String
  summary    String // markdown
  topStories Json // [{ articleId, title, url, why }]
  createdAt  DateTime @default(now())

  @@unique([date, locale])
  @@index([date])
}

// =========================================================
// Wire source and article models
// =========================================================

enum SourceTier {
  T0
  T1
  T2
  T3
}

model Source {
  id                  String     @id @default(cuid())
  name                String
  feedUrl             String     @unique
  enabled             Boolean    @default(true)
  category            String
  tier                SourceTier @default(T2)
  lastFetchAt         DateTime?
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  lastLatencyMs       Int?
  consecutiveFailures Int        @default(0)
  nextFetchAt         DateTime?
  feedEtag            String?
  feedLastModified    String?
  lastHttpStatus      Int?
  lastNotModifiedAt   DateTime?
  lastRetryAfterMs    Int?
  createdAt           DateTime   @default(now())
  articles            Article[]

  @@index([enabled, tier, nextFetchAt])
}

model Article {
  id                String             @id
  sourceId          String
  sourceName        String
  title             String
  url               String             @unique
  publishedAt       DateTime
  summary           String? // legacy alias retained while clients migrate to feedExcerpt
  feedExcerpt       String?
  metaDescription   String?
  tags              String             @default("[]") // JSON array stored as string
  importanceTier    String             @default("general")
  importanceScore   Int                @default(0)
  importanceReasons String             @default("[]")
  isRead            Boolean            @default(false)
  isSaved           Boolean            @default(false)
  createdAt         DateTime           @default(now())
  source            Source             @relation(fields: [sourceId], references: [id])
  enrichment        ArticleEnrichment?
  readStates        ReadState[]
  savedArticles     SavedArticle[]
  eventLinks        EventArticle[]

  @@index([publishedAt])
  @@index([sourceId])
  @@index([url])
  @@index([importanceTier, publishedAt])
}

model ArticleEnrichment {
  articleId      String   @id
  keyFacts       Json
  keyNumbers     Json
  whyItMatters   String?
  entities       Json
  contentSources Json
  analysisKind   String?
  enrichedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt
  article        Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([enrichedAt])
}

// =========================================================
// Event graph: multiple articles describing the same story
// =========================================================

model Event {
  id                 String         @id @default(cuid())
  eventKey           String         @unique
  title              String
  firstSeenAt        DateTime
  lastSeenAt         DateTime
  latestPublishedAt  DateTime
  importanceTier     String         @default("general")
  importanceScore    Int            @default(0)
  coverageCount      Int            @default(1)
  primarySourceName  String?
  officialSourceName String?
  tags               String         @default("[]")
  regions            String         @default("[]")
  marketChannels     String         @default("[]")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  articles           EventArticle[]

  @@index([latestPublishedAt])
  @@index([importanceScore, latestPublishedAt])
}

model EventArticle {
  eventId          String
  articleId        String   @unique
  sourceName       String
  publishedAt      DateTime
  similarityScore Float?
  isPrimary        Boolean  @default(false)
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  article          Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([eventId, articleId])
  @@index([publishedAt])
}
