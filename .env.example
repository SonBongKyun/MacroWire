# =========================================================
# Database (Neon Postgres)
# =========================================================
DATABASE_URL="postgresql://USER:PASS@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASS@HOST.region.aws.neon.tech/neondb?sslmode=require"

# =========================================================
# Fast Wire background worker (optional overrides)
# Defaults: T0 45s, T1 25s, T2 120s, T3 600s
# =========================================================
WIRE_WORKER_CONCURRENCY="4"
WIRE_LOOP_INTERVAL_MS="1000"
WIRE_T0_INTERVAL_MS="45000"
WIRE_T1_INTERVAL_MS="25000"
WIRE_T2_INTERVAL_MS="120000"
WIRE_T3_INTERVAL_MS="600000"

# =========================================================
# Discord real-time alerts
# Incoming webhook secret: Discord channel settings → Integrations → Webhooks
# Defaults: T0/T1, score 38+, published within 30m, max 10 per delivery
# =========================================================
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN"
DISCORD_ALERTS_ENABLED="true"
DISCORD_ALERT_SOURCE_TIERS="T0,T1"
DISCORD_ALERT_MIN_SCORE="55"
DISCORD_ALERT_MAX_AGE_MINUTES="30"
DISCORD_ALERT_MAX_ARTICLES="5"
DISCORD_WEBHOOK_USERNAME="MacroWire"

# =========================================================
# Clerk (auth)
# Get from: https://dashboard.clerk.com → Your project → API keys
# =========================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."        # from Clerk → Webhooks → Endpoint
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/app"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/app"

# =========================================================
# Stripe (billing)
# Create products in dashboard, then paste price IDs here.
# =========================================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_PRICE_PRO="price_..."             # monthly PRO price id
STRIPE_PRICE_ELITE="price_..."           # monthly ELITE price id

# =========================================================
# OpenRouter (optional AI insights)
# Get from: https://openrouter.ai/keys
# =========================================================
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_MODEL_FREE="anthropic/claude-haiku-4.5"
OPENROUTER_MODEL_PRO="anthropic/claude-sonnet-4.5"
OPENROUTER_MODEL_ELITE="anthropic/claude-opus-4.1"

# =========================================================
# Resend (transactional email — daily digest)
# =========================================================
RESEND_API_KEY="re_..."
RESEND_FROM="MacroWire <noreply@yourdomain.com>"

# =========================================================
# Site
# =========================================================
NEXT_PUBLIC_SITE_URL="https://macro-wire-psi.vercel.app"
CRON_SECRET="any-long-random-string"     # shared secret for /api/ingest cron auth
ADMIN_CLERK_IDS="user_..."                # comma-separated global source administrators
MACROWIRE_OWNER_SECRET="replace-with-a-long-random-secret" # required for AI POST when Clerk is disabled
WEBHOOK_ALLOWED_HOSTS=""                  # optional additional HTTPS webhook hosts
