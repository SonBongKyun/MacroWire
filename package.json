{
  "name": "macro-wire",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/run-production-migrations.mjs && prisma generate && next build",
    "start": "next start",
    "worker:wire": "tsx workers/wire-worker.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "tsx --test tests/**/*.test.ts",
    "icons": "node scripts/generate-icons.mjs",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@clerk/nextjs": "7.5.2",
    "@openrouter/sdk": "^1.2.27",
    "@prisma/client": "6.19.3",
    "@stripe/stripe-js": "^9.4.0",
    "lucide-react": "^1.26.0",
    "next": "^16.2.11",
    "next-intl": "^4.11.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.12.3",
    "rss-parser": "^3.13.0",
    "stripe": "^22.1.1",
    "svix": "^1.93.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "4.22.4",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1",
    "postcss": "8.5.26",
    "nanoid": "3.3.18",
    "sharp": "0.35.3",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.16"
    }
  }
}
